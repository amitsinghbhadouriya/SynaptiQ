# Copy to .env and adjust. Never commit a real .env file.

# --- Generator -------------------------------------------------------------
# offline   : extractive answers from the evidence, no API key needed (default)
# anthropic : Claude through the official SDK; also writes synthetic test questions
LLM_PROVIDER=offline
# ANTHROPIC_API_KEY=replace_with_your_key
LLM_MODEL=claude-opus-5-5
# Claude effort level: low | medium | high | xhigh | max
LLM_EFFORT=low
# Server-side refusal fallback (re-runs a declined request on Anthropic's recommended model)
LLM_REFUSAL_FALLBACK=true
LLM_TIMEOUT_S=60
# Optional price override for cost estimates, USD per million tokens
# LLM_INPUT_PRICE_PER_MTOK=4.0
# LLM_OUTPUT_PRICE_PER_MTOK=20.0

# --- Embeddings and vectors ------------------------------------------------
# auto: sentence-transformers, falling back to offline hashing embeddings if the model can't load
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# auto | chroma | memory
VECTOR_BACKEND=auto

# --- Default run configuration --------------------------------------------
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=4

# --- Storage and limits ----------------------------------------------------
CHROMA_PATH=./storage/chroma
DB_PATH=./storage/synaptiq.db
UPLOAD_DIR=./storage/uploads
REPORTS_DIR=./reports
MAX_UPLOAD_MB=20
MAX_QUESTIONS=50
RAGAS_ENABLED=true
